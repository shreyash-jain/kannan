# Copy to .env.local and fill in. Never commit real values.
# On Cloudflare Pages these go in Settings → Environment variables.

# --- Media pipeline ------------------------------------------------
# Used by scripts/upload-to-cloudinary.py. Contains the API secret.
CLOUDINARY_URL=

# --- Admin dashboard (/admin) --------------------------------------
# Sign-in for the admin area.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Google Analytics 4 Data API ------------------------------------
# Powers the analytics on /admin. While these are blank the dashboard
# serves clearly-labelled demo data instead of erroring.
#
# PROPERTY_ID  numeric, from GA4 → Admin → Property details.
#              NOT the "G-..." measurement ID in src/app/layout.tsx.
# CLIENT_EMAIL / PRIVATE_KEY come from a Google Cloud service-account
#              JSON key. The service account must be added to the GA4
#              property (Admin → Property access management) as Viewer.
#
# Keep the private key on ONE line, wrapped in double quotes, with the
# \n sequences exactly as they appear in the JSON file.
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=""
